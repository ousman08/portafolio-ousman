# Configuración del backend de Huellas (server/index.js).
# Copia este archivo como `server/.env` y ajusta los valores.
# `server/.env` está en .gitignore: nunca se sube al repositorio.

# Puerto del servidor (por defecto 8787).
PORT=8787

# Origen público del sitio. Se usa como valor por defecto en ALLOWED_ORIGINS.
SITE_URL=http://localhost:5173

# Lista de orígenes autorizados a llamar a la API (CORS), separados por comas.
# En producción: solo tu dominio real, sin barra final.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Token de administración de la cola de moderación (mínimo 24 caracteres).
# Sin él, /api/admin/* responde 503 y no se puede aprobar ni retirar nada.
# Genéralo con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_TOKEN=

# Ruta del archivo JSON donde se guardan las huellas.
# Por defecto: server/data/huellas.json
DATA_FILE=server/data/huellas.json
